PORT=3000
NODE_ENV=development
# Origin allowed to call the API. The interface is served by this same process,
# so leave it as the API's own origin unless you host the files separately.
CLIENT_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=fruit
DB_PASSWORD=change_me
DB_NAME=fruit_ripeness

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

ML_SERVICE_URL=http://localhost:5001

# Only needed if the interface lives somewhere other than ../frontend
# FRONTEND_DIR=/srv/fruit-ripeness/frontend

# Optional. Without a key the assistant answers from the knowledge base.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Seeded by `npm run migrate` — change the password before any real deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_now
